{
  "name": "irae-api-mocking-proxy",
  "version": "1.2.0",
  "description": "An (HTTP) API proxy server that stores and replays captured responses.",
  "author": "Colin Bate <colin@colinbate.com>",
  "contributors": [
    "Tomas Zezula <zezulatomas@gmail.com>"
  ],
  "bin": {
    "amp": "bin/amp"
  },
  "scripts": {
    "build": "babel src --out-dir lib",
    "start": "npm run build && node lib/cli.js",
    "lint": "eslint .",
    "unit": "mocha",
    "test": "npm run build && npm run lint && npm run unit",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irae/api-mocking-proxy"
  },
  "bugs": {
    "url": "https://github.com/irae/api-mocking-proxy/issues"
  },
  "keywords": [
    "mock",
    "replay",
    "http proxy",
    "api",
    "scrape",
    "scraping",
    "api mock",
    "api mock server"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "config": "^4.4.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "minimist": "^1.2.8",
    "morgan": "^1.10.1",
    "qs": "^6.15.3",
    "serve-favicon": "^2.5.1",
    "toml": "^5.0.1",
    "type-is": "^3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "eslint": "^10.0.1",
    "mocha": "^12.0.3",
    "neostandard": "^0.14.1",
    "nock": "^15.0.6",
    "node-mocks-http": "^1.18.1"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "mocha": {
      "glob": "^14.0.4"
    }
  },
  "analyze": true,
  "license": "MIT",
  "homepage": "https://github.com/irae/api-mocking-proxy",
  "main": "lib/index.js",
  "directories": {
    "test": "test"
  }
}
